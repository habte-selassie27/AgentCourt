# AgentCourt frontend environment
# Copy to .env.local for local dev; set the same vars in Vercel (Production + Preview).
# Only VITE_* variables are exposed to the browser build — never put secrets here.

VITE_RPC_URL=https://studio.genlayer.com/api
VITE_CHAIN_ID=61999
VITE_AGENTCOURT_CORE=0x1201eF62b96133c652c668e200C096D16BcaD0CF
VITE_DISPUTE_REGISTRY=0x57802A80B38c68a7EbE814F4249a8Ac6768319b4
VITE_RESOLUTION_MANAGER=0xa8c7C20Edd5db93067203939Ad6a85eDb52B5F55
VITE_DISPUTE_JUDGE=0x9CAB521b93549C314E17a7Ed8ddEeA6BAd8f2662
VITE_EVIDENCE_VERIFIER=0x913DE37be72E2D6C4Ad10AD853753C0a4cB2DfFE
VITE_ADVERSARIAL_REVIEWER=0xFB94C2A452ab97d45165B967715df988283C00A1
VITE_CONSENSUS_ENGINE=0xa0619c616895110FCa35f94136B46f60225c8974

# Backend / contracts (not used by the frontend build)
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_PRIVATE_KEY=0x_your_private_key_here
GENLAYER_CHAIN_ID=61999

# Foundry
PRIVATE_KEY=0x_your_private_key_here
