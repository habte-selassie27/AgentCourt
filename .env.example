# AgentCourt frontend environment
# Copy to .env for local dev; set the same vars in Vercel (Production + Preview).
# Only VITE_* variables are exposed to the browser build — never put secrets here.

VITE_RPC_URL=https://studio.genlayer.com/api
VITE_CHAIN_ID=61999
VITE_AGENTCOURT_CORE=0x88D6013FC7aC2c0Af802F4DaC6F7e3d5983e5685
VITE_RESOLUTION_MANAGER=0xA0F4D59ba22651bb11e48C4d827ED160c2b30525

# Backend / contracts (not used by the frontend build)
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_PRIVATE_KEY=0x_your_private_key_here
GENLAYER_CHAIN_ID=61999
AGENTCOURT_CORE=0x88D6013FC7aC2c0Af802F4DaC6F7e3d5983e5685
RESOLUTION_MANAGER=0xA0F4D59ba22651bb11e48C4d827ED160c2b30525
