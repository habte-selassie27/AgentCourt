{
  "name": "agentcourt",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous Dispute Resolution for the Agent Economy",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "tsc && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "contracts:build": "forge build",
    "contracts:test": "forge test -vvv"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
